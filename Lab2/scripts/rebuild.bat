@echo off
REM 修复 ACK 丢包问题后重新编译

echo ========================================
echo 清理旧的编译产物...
echo ========================================
nmake clean

echo.
echo ========================================
echo 重新编译项目...
echo ========================================
nmake

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================
    echo 编译成功！
    echo ========================================
    echo.
    echo 修复内容：
    echo   - 接收端 ACK 不再被丢包模拟函数影响
    echo   - 控制包 (SYN, ACK, FIN) 始终发送
    echo   - 只有数据包会被丢包模拟
    echo.
    echo 现在重新测试，性能应该大幅提升！
    echo 预期：70KB 数据应该在 1-2 秒内传输完成
    echo.
) else (
    echo 编译失败！
    pause
    exit /b 1
)

pause
